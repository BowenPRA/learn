{
  "name": "pra-learn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5201 --strictPort",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --port 5201",
    "test": "node --test tests/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:env": "node scripts/check-env.mjs",
    "sync:classroom": "node scripts/sync-classroom.mjs",
    "sync:dashboard": "node scripts/sync-dashboard.mjs",
    "predeploy": "node scripts/check-env.mjs && vite build --mode production",
    "deploy": "gh-pages -d dist -r https://BowenPRA@github.com/BowenPRA/learn.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.14.0",
    "lucide-react-classroom": "npm:lucide-react@1.28.0",
    "lucide-react-dashboard": "npm:lucide-react@1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.0.10"
  }
}
